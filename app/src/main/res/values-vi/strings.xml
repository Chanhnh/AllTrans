    <string name="master_on_off">"Bật/Tắt chính"</string>
    <string name="master_on_off_summary_off">"Mô-đun đang tắt, sẽ không có ứng dụng nào được dịch. Bật lên để bắt đầu dùng dịch tự động."</string>
    <string name="master_on_off_summary_on">"Mô-đun đang bật, các ứng dụng đã chọn sẽ được dịch. Tắt để vô hiệu hóa hoàn toàn mô-đun này."</string>

    <string name="translator_provider">"Nhà cung cấp dịch vụ dịch"</string>
    <string name="translator_provider_summary">"Chọn dịch vụ dịch muốn dùng: Google Translate, Microsoft Translate hoặc VietPhrase"</string>
    <string name="translator_provider_google">Google Translate\nDùng phần tích hợp Google có sẵn. Cần kết nối Internet.</string>
    <string name="translator_provider_microsoft">Microsoft Translate\nDùng phần tích hợp Microsoft có sẵn. Cần kết nối Internet.</string>
    <string name="translator_provider_vietphrase">VietPhrase\nDùng các file từ điển cục bộ để dịch một chiều từ tiếng Trung sang tiếng Việt. Không cần Internet.</string>

    <string name="downloading">"Đang xử lý dữ liệu dịch. Vui lòng chờ"</string>

    <string name="transFrom">"Dịch từ ngôn ngữ"</string>
    <string name="transFrom_summary">"Ngôn ngữ gốc của ứng dụng."</string>

    <string name="transTo">"Dịch sang ngôn ngữ"</string>
    <string name="transTo_summary">"Ngôn ngữ bạn muốn ứng dụng được dịch sang."</string>

    <string name="setText">"Dịch văn bản thông thường"</string>
    <string name="setText_summary_off">"Không dịch văn bản được đặt bằng Set Text. Bật để kích hoạt."</string>
    <string name="setText_summary_on">"Đang dịch văn bản được đặt bằng Set Text. An toàn. Tắt để vô hiệu hóa."</string>

    <string name="setHint">"Dịch gợi ý văn bản (chữ màu xám) trong ô nhập"</string>
    <string name="setHint_summary_off">"Không dịch văn bản được đặt bằng Set Hint. Bật để kích hoạt."</string>
    <string name="setHint_summary_on">"Đang dịch văn bản được đặt bằng Set Hint. An toàn. Tắt để vô hiệu hóa."</string>

    <string name="extended_view_translation">"Dịch mở rộng ngoài TextView"</string>
    <string name="extended_view_translation_summary_off">"Chỉ dùng đường dịch gốc của TextView và setText. Các hook mở rộng như StaticLayout.Builder.build(), constructor layout, method của View framework và setter của custom View sẽ bị tắt."</string>
    <string name="extended_view_translation_summary_on">"Bật các hook dịch bổ sung ngoài đường TextView gốc, bao gồm StaticLayout.Builder.build(), constructor layout, method của View framework và setter của custom View."</string>

    <string name="webView">"Dịch văn bản trong trang web bên trong ứng dụng"</string>
    <string name="webView_summary_off">"Không dịch văn bản trong WebView. Bật để kích hoạt."</string>
    <string name="webView_summary_on">"Đang dịch văn bản trong WebView. An toàn nhưng có thể không phải lúc nào cũng hoạt động. Tắt để vô hiệu hóa."</string>

    <string name="notif">"Dịch thông báo"</string>
    <string name="notif_summary_off">"Không dịch văn bản trong thông báo. Bật để kích hoạt."</string>
    <string name="notif_summary_on">"Đang dịch văn bản trong thông báo. An toàn nhưng đôi khi có thể làm ứng dụng bị lỗi. Tắt để vô hiệu hóa."</string>


    <string name="caching">"Dùng bộ nhớ đệm"</string>
    <string name="caching_summary_off">"Không lưu bộ nhớ đệm bản dịch. Việc dịch có thể chậm hơn và dùng nhiều dữ liệu mạng hơn, nhưng có thể hoạt động tốt hơn với một số ứng dụng. Bật để lưu bộ nhớ đệm bản dịch."</string>
    <string name="caching_summary_on">"Đang lưu bộ nhớ đệm bản dịch để tăng tốc độ dịch và giảm các yêu cầu mạng lặp lại. Tắt nếu ứng dụng đã dịch hoạt động không ổn định."</string>

    <string name="delay">"Độ trễ trước khi thay bằng văn bản đã dịch"</string>
    <string name="delay_summary">"Đặt thời gian chờ theo mili giây trước khi thay văn bản bằng bản dịch. Giá trị mặc định là 0. Hãy đặt 1000-5000 nếu ứng dụng bị lỗi sau khi dịch."</string>

    <string name="delay_webview">"Độ trễ trước khi bắt đầu dịch WebView"</string>
    <string name="delay_webview_summary">"Đặt thời gian chờ theo mili giây trước khi bắt đầu dịch WebView. Giá trị mặc định là 500. Đặt 0 để tăng tốc dịch. Đặt 3000-5000 nếu một phần nội dung web chưa được dịch."</string>

    <string name="scroll">"Cuộn văn bản dịch dài"</string>
    <string name="scroll_summary_off">"Không cuộn văn bản đã dịch nếu nó quá dài. Văn bản có thể bị cắt bớt nhưng sẽ không ảnh hưởng đến thao tác cuộn/chạm của ứng dụng. Bật để cuộn các bản dịch dài."</string>
    <string name="scroll_summary_on">"Đang cuộn văn bản đã dịch nếu quá dài. Điều này có thể ảnh hưởng đến thao tác cuộn/chạm của ứng dụng. Tắt để vô hiệu hóa tính năng cuộn này."</string>

    <string name="debug">"Nâng cao: Bật chế độ gỡ lỗi."</string>
    <string name="debug_summary_off">"Chế độ gỡ lỗi đang tắt. Không ghi dữ liệu gỡ lỗi vào logcat. Hãy bật tính năng này trước khi gửi báo cáo lỗi."</string>
    <string name="debug_summary_on">"Chế độ gỡ lỗi đang bật. Nhật ký sẽ được ghi vào logcat. Điều này làm giảm hiệu năng, hãy tắt nếu không cần."</string>

    <string name="local_on_off">"Dịch ứng dụng này"</string>
    <string name="local_on_off_summary">"Tắt để ngừng dịch ứng dụng này"</string>
    <string name="local_on_off_summary_off">"Ứng dụng này sẽ không được dịch. Bật để bắt đầu dùng dịch tự động."</string>
    <string name="local_on_off_summary_on">"Ứng dụng này sẽ được dịch. Tắt để vô hiệu hóa hoàn toàn việc dịch ứng dụng này."</string>

    <string name="overRide_global">"Ghi đè cài đặt toàn cục"</string>
    <string name="overRide_global_summary_off">"Đang dùng cài đặt toàn cục cho ứng dụng này. Bật để thay đổi cài đặt chỉ cho ứng dụng này."</string>
    <string name="overRide_global_summary_on">"Đang dùng cài đặt riêng cho ứng dụng này. Tắt để quay về cài đặt toàn cục."</string>

    <string name="clear_cache">"Nhấn để xóa bộ nhớ đệm bản dịch"</string>
    <string name="clear_cache_summary">"Nhấn vào đây để xóa bộ nhớ đệm bản dịch của ứng dụng. Hãy dùng sau khi đổi cài đặt dịch hoặc khi ứng dụng không khởi động đúng."</string>
    <string name="clear_cache_provider">"Bộ nhớ đệm bản dịch sẽ được xóa vì nhà cung cấp đã thay đổi."</string>
